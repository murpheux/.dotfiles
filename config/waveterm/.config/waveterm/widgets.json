{
  "speedtest": {
    "icon": "gauge-high",
    "label": "speed",
    "blockdef": {
      "meta": {
        "view": "term",
        "controller": "cmd",
        "cmd": "/opt/homebrew/bin/speedtest-go --unix",
        "cmd:clearonstart": true
      }
    }
  },
  "github": {
    "icon": "brands@github",
    "label": "github",
    "blockdef": {
      "meta": {
        "view": "web",
        "url": "https://github.com",
        "pinnedurl": "https://google.com"
      }
    }
  },
  "3min-info": {
    "icon": "circle-3",
    "label": "3mininfo",
    "blockdef": {
      "meta": {
        "view": "sysinfo",
        "graph:numpoints": 180,
        "sysinfo:type": "CPU + Mem"
      }
    }
  },
  "all-cpu": {
    "icon": "chart-scatter",
    "label": "all-cpu",
    "blockdef": {
      "meta": {
        "view": "sysinfo",
        "sysinfo:type": "All CPU"
      }
    }
  }
}